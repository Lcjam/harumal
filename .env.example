# Application
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
SITE_ADDRESS=http://localhost
# Public production requires exactly 64 hex characters from: openssl rand -hex 32
APP_SECRET=development-only-secret-change-before-production

# PostgreSQL
DATABASE_URL=postgresql://harumal:harumal@localhost:5432/harumal

# Kakao Developers JavaScript key (public key, not an admin key)
NEXT_PUBLIC_KAKAO_JS_KEY=

# Operations
TZ=Asia/Seoul
BACKUP_RETENTION_DAYS=14
POSTGRES_DB=harumal
POSTGRES_USER=harumal
POSTGRES_PASSWORD=development-only-db-password
# Runtime role: its password is derived from APP_SECRET and is never exposed
# to the app container as the PostgreSQL administrator password.
APP_DB_USER=harumal_app
