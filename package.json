{
  "name": "harumal",
  "version": "1.0.0",
  "private": true,
  "description": "하루 동안 친구들과 서로 문제를 내고 푸는 자모 단어 게임",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/index.ts",
    "build": "next build --webpack",
    "start": "NODE_ENV=production node --import tsx scripts/start.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:integration": "RUN_INTEGRATION=1 node --import tsx --test tests/*.integration.test.ts",
    "test:e2e": "RUN_E2E=1 node --import tsx --test tests/api.e2e.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:backup": "sh scripts/backup.sh",
    "db:restore": "sh scripts/restore.sh"
  },
  "dependencies": {
    "compression": "1.8.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "next": "16.3.0",
    "pg": "8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "tsx": "4.22.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "22.19.19",
    "@types/pg": "8.20.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  },
  "type": "module"
}
